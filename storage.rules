rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Reglas para las imágenes de productos
    match /products/{imageName} {
      // Permitir lectura pública (cualquiera puede ver las imágenes)
      allow read: if true;
      
      // Solo usuarios autenticados pueden subir, actualizar o eliminar imágenes
      allow create, update, delete: if request.auth != null;
    }
    
    // Reglas para otras carpetas
    match /{allPaths=**} {
      // Por defecto, lectura pública y escritura solo para autenticados
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

