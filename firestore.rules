rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reglas para la colección de productos
    match /products/{productId} {
      // Permitir lectura pública (cualquiera puede ver los productos)
      allow read: if true;
      
      // Solo usuarios autenticados pueden crear, actualizar o eliminar productos
      allow create, update, delete: if request.auth != null;
    }
    
    // Reglas para la colección de categorías
    match /categories/{categoryId} {
      // Permitir lectura pública
      allow read: if true;
      
      // Solo usuarios autenticados pueden modificar
      allow create, update, delete: if request.auth != null;
    }
    
    // Reglas para la colección de pedidos
    match /orders/{orderId} {
      // Cualquiera puede crear un pedido (clientes)
      allow create: if true;
      
      // Solo usuarios autenticados pueden leer, actualizar o eliminar pedidos
      allow read, update, delete: if request.auth != null;
    }
    
    // Reglas para contadores (orderCounter, productCounter)
    match /counters/{counterId} {
      // Solo usuarios autenticados pueden leer contadores
      allow read: if request.auth != null;
      
      // Permitir escritura para crear/actualizar contadores
      allow write: if true;
    }
    
    // Reglas para configuración global
    match /config/{configId} {
      // Permitir lectura pública para obtener configuraciones
      allow read: if true;
      
      // Solo usuarios autenticados pueden modificar configuración
      allow write: if request.auth != null;
    }
    
    // Reglas para otras colecciones (si las hay)
    match /{document=**} {
      // Por defecto, lectura pública y escritura solo para autenticados
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}